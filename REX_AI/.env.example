# Copy to .env and fill in (loaded automatically by rex_ai/config.py). Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Change requests ("make changes") in the Curriculum, Document and Marketing agents use Gemini; everything else OpenAI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 1 = use the LLM when a key is set; 0 = always use the deterministic responder
REX_USE_LLM=1
REX_API_URL=http://127.0.0.1:8000
# ---- Shared database: every action is saved here and seen from any machine / server ----
# PostgreSQL URL (Neon, Supabase, Render, RDS... - copy it from the provider's dashboard). Empty = local SQLite file.
REX_DATABASE_URL=
# REX_DB_SCHEMA=                       # optional schema, e.g. one per environment (dev / demo)
# REX_DB_POOL_SIZE=5
# REX_SHARED_FILES=1                   # uploaded files are kept in the database too (default: on with a URL)
# REX_FILE_SYNC_SECONDS=60             # how often a server picks up files uploaded on another one
# REX_DB_PATH=rex_ai.db                # local SQLite file, used only when REX_DATABASE_URL is empty
# REX_DATA_DIR=data
# ---- Shared RAG pipeline ----
# auto | sentence-transformers | openai | hash   (hash = offline fallback, no download)
REX_RAG_EMBEDDINGS=sentence-transformers
REX_RAG_EMBED_MODEL=intfloat/multilingual-e5-small
# OPENAI_EMBED_MODEL=text-embedding-3-small
# REX_CHROMA_DIR=data/chroma
# ---- E-mail (SMTP): approved documents and qualified tenders are really sent - nothing is queued ----
# Gmail: smtp.gmail.com, port 587, your Gmail address, and an App Password from https://myaccount.google.com/apppasswords
# (needs 2-Step Verification; the normal Gmail password is refused). Port 465 = SSL, anything else = STARTTLS.
REX_SMTP_HOST=smtp.gmail.com
REX_SMTP_PORT=587
REX_SMTP_USER=
REX_SMTP_PASSWORD=
# REX_SMTP_FROM=                       # defaults to REX_SMTP_USER
# ---- Tender / RFP Research Agent ----
# REX_RFP_TODAY=2026-10-24             # pin the date when demoing on the fixed sample tenders
# REX_RFP_WEBHOOK_URL=                 # Slack/Teams/n8n incoming webhook for new-RFP alerts
# REX_RFP_ALERT_EMAILS=bids@academy.example
# ---- Curriculum & Accreditation Alignment Agent ----
# REX_CURRICULUM_OUTPUT_DIR=outputs/curricula   # generated PDFs
# REX_CURRICULUM_SEMANTIC_MIN=                  # similarity for "partial" coverage; empty = per-embedder default
# REX_PDF_FONT=C:/Windows/Fonts/arial.ttf       # TTF with Arabic glyphs; empty = first found (Arial, Tahoma, DejaVu, Noto)
# REX_PDF_FONT_BOLD=C:/Windows/Fonts/arialbd.ttf
# ---- Document Generation Agent ----
# REX_DOCUMENT_OUTPUT_DIR=outputs/documents       # generated PDFs (+ outbox/ for e-mails when SMTP is not set)
# REX_DOC_TEMPLATES_DIR=data/doc_templates        # templates.yaml + reference examples (RAG collection doc_templates)
# Approved documents are e-mailed (really sent) with the REX_SMTP_* settings above.
# ---- AI Marketing Agent ----
# REX_MARKETING_DIR=data/marketing                # channels.yaml, audiences.yaml, references/ (RAG collection marketing_refs)
# REX_MARKETING_OUTPUT_DIR=outputs/campaigns      # brief PDFs, publish packages (+ outbox/ for e-mails without SMTP)
# The e-mail variant of a published campaign is sent with the REX_SMTP_* settings above.
# ---- Accounts ----
# Code people type to sign up as administrator (the first administrator needs none). Empty = only by promotion.
REX_ADMIN_SIGNUP_CODE=
# REX_LOGIN_DAYS=7
# REX_API_AUTH=1                       # 0 = API without login (local scripts, tests)
